# Copy to .env and fill in your values before running docker compose up.

# Required. A GitHub fine-grained PAT scoped to your org.
# Minimum: Actions: Read (workflow runs + status).
# Add Pull requests: Read for open-PR counts.
# Add Contents: Read for code metrics (Lizard clones repos; needs read access).
# See operator-handoff.md for the full scope table and token creation steps.
GITHUB_TOKEN=github_pat_...

# Required. The GitHub organization whose repos the board should show.
GITHUB_OWNER=your-org-name

# Optional, DANGEROUS. When "true", the unauthenticated /api/dashboard/snapshot
# endpoint returns the FULL snapshot, including private repositories, to any
# anonymous caller that can reach the port. Leave UNSET (the default is false,
# public-only) for any internet-reachable deployment. Only set it for a private,
# trusted-network instance where every client is already authorised to see
# private-repo data. If you set it, expose the port to localhost / a private
# network, never to 0.0.0.0 on a public host.
# Admin__ExposePrivateToGuests=true
