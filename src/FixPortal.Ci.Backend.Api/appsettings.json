{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http": "Warning"
    }
  },
  "GitHub": {
    "Owner": "FixPortal",
    "Token": ""
  },
  "Dashboard": {
    "SnapshotPath": "App_Data/dashboard-snapshot.json",
    "RefreshSeconds": 20,
    "ExcludeArchived": true,
    "IncludeReusable": false,
    "IncludeCodeQl": true,
    "MetricsEnabled": true,
    "MetricsRefreshSeconds": 43200,
    "MetricsWorkDirectory": "",
    "MergedPrEnabled": true,
    "MergedPrRefreshSeconds": 150,
    "JobLanes": [
      { "Key": "deploys", "Label": "Deploys", "RefreshSeconds": 150, "Patterns": [ "deploy" ] },
      { "Key": "packages", "Label": "Packages", "RefreshSeconds": 150, "Patterns": [ "publish", "package", "docker", "image", "release", "ghcr" ] }
    ]
  },
  "ReviewSignals": {
    "Enabled": true,
    "RefreshSeconds": 150,
    "ExcludedAuthors": [ "dependabot", "dependabot[bot]", "renovate", "renovate[bot]" ],
    "Reviewers": []
  }
}
